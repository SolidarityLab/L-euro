{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:l-euro:schema:v0.1:entitlement",
  "title": "L-euro Entitlement (draft v0.1)",
  "description": "Minimum attribute set of an L-euro entitlement. Draft, not stable. SPDX-License-Identifier: EUPL-1.2",
  "type": "object",
  "required": [
    "id",
    "form",
    "programme",
    "issuer",
    "payers",
    "holder",
    "acceptanceNetwork",
    "unit",
    "nominal",
    "balance",
    "goodsClass",
    "divisible",
    "validFrom",
    "validUntil",
    "transferable",
    "convertible",
    "coverMode",
    "remainderRule",
    "status",
    "signature",
    "revocationUri"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier of the entitlement"
    },
    "form": {
      "enum": [
        "voucher",
        "coupon",
        "ticket",
        "discount"
      ]
    },
    "programme": {
      "type": "string",
      "description": "Legal or contractual regime, as a URI or code"
    },
    "issuer": {
      "$ref": "#/$defs/party"
    },
    "payers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "party",
          "share"
        ],
        "properties": {
          "party": {
            "$ref": "#/$defs/party"
          },
          "share": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "inKind": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "holder": {
      "type": "object",
      "description": "Pseudonymous reference to the holder account (партида) at the depositary. MUST NOT reveal identity to the acceptor.",
      "required": [
        "ref"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "description": "Opaque holder account reference"
        },
        "representative": {
          "type": "string"
        },
        "group": {
          "type": "string"
        }
      }
    },
    "acceptanceNetwork": {
      "type": "object",
      "properties": {
        "acceptors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "category": {
          "type": "string"
        }
      }
    },
    "unit": {
      "enum": [
        "EUR",
        "count",
        "percent"
      ]
    },
    "nominal": {
      "type": "number",
      "minimum": 0
    },
    "balance": {
      "type": "number",
      "minimum": 0
    },
    "goodsClass": {
      "type": "object",
      "required": [
        "scheme",
        "code"
      ],
      "properties": {
        "scheme": {
          "type": "string",
          "description": "Classification, e.g. COICOP (open question)"
        },
        "code": {
          "type": "string"
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "divisible": {
      "type": "boolean"
    },
    "validFrom": {
      "type": "string",
      "description": "Event that starts validity; default: load"
    },
    "validUntil": {
      "type": "string",
      "description": "Date (ISO 8601) or duration from validFrom"
    },
    "transferable": {
      "type": "boolean",
      "default": false
    },
    "convertible": {
      "type": "boolean",
      "default": false
    },
    "coverMode": {
      "enum": [
        "prepaid",
        "guaranteed",
        "creditLine",
        "capacity"
      ]
    },
    "remainderRule": {
      "enum": [
        "toPayer",
        "toFund",
        "extinguish",
        "releaseCapacity"
      ]
    },
    "taxTreatment": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "quotaRef": {
          "type": "string"
        }
      }
    },
    "status": {
      "enum": [
        "requested",
        "issued",
        "loaded",
        "redeemed",
        "expired",
        "revoked",
        "settled"
      ]
    },
    "signature": {
      "type": "string"
    },
    "revocationUri": {
      "type": "string",
      "format": "uri"
    }
  },
  "$defs": {
    "party": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    }
  }
}
