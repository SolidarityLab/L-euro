{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/SolidarityLab/L-euro/main/DTEP/DTEP-S/schema/audit-record.json",
  "title": "DTEP-S Audit Record",
  "description": "Schema for DTEP-S audit trail artifacts: trail root documents, Merkle proofs, and audit reports. Published by the Auditor to provide cryptographic proof of the integrity and completeness of the Redemption Event sequence.",
  "oneOf": [
    { "$ref": "#/$defs/trailRoot" },
    { "$ref": "#/$defs/merkleProof" },
    { "$ref": "#/$defs/auditReport" }
  ],
  "$defs": {
    "trailRoot": {
      "type": "object",
      "title": "DTEPTrailRoot",
      "description": "Periodic public commitment by the Auditor to the state of the audit trail. Once signed and published, cannot be altered without invalidating the proof.",
      "required": [
        "type",
        "id",
        "auditor",
        "batchIndex",
        "batchRoot",
        "eventCount",
        "firstEventId",
        "lastEventId",
        "generatedAt",
        "proof"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "DTEPTrailRoot"
        },
        "id": {
          "type": "string",
          "description": "Unique trail root document identifier.",
          "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "auditor": {
          "type": "string",
          "description": "Auditor DID.",
          "pattern": "^did:"
        },
        "batchIndex": {
          "type": "integer",
          "description": "Sequential batch index. Zero for first batch. Strictly increasing.",
          "minimum": 0
        },
        "batchRoot": {
          "type": "string",
          "description": "Hex-encoded Merkle root of this batch.",
          "pattern": "^[0-9a-f]{64}$"
        },
        "previousRoot": {
          "type": "string",
          "description": "Hex-encoded trail root of previous batch. Absent only for batchIndex 0.",
          "pattern": "^[0-9a-f]{64}$"
        },
        "eventCount": {
          "type": "integer",
          "description": "Cumulative event count up to and including this batch. Strictly greater than previous batch eventCount.",
          "minimum": 1
        },
        "firstEventId": {
          "type": "string",
          "description": "urn:uuid of first event in this batch.",
          "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "lastEventId": {
          "type": "string",
          "description": "urn:uuid of last event in this batch.",
          "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "generatedAt": {
          "type": "string",
          "description": "ISO-8601 datetime of root computation.",
          "format": "date-time"
        },
        "anchoringRef": {
          "type": "object",
          "description": "Optional reference to external anchoring of this trail root.",
          "properties": {
            "mechanism": {
              "type": "string",
              "enum": [
                "bis-registry",
                "opentimestamps",
                "issuer-countersignature",
                "multi-party"
              ]
            },
            "ref": {
              "type": "string",
              "description": "Mechanism-specific reference string."
            }
          },
          "additionalProperties": false
        },
        "proof": {
          "$ref": "#/$defs/auditorProof"
        }
      },
      "additionalProperties": false
    },
    "merkleProof": {
      "type": "object",
      "title": "DTEPMerkleProof",
      "description": "Cryptographic proof of inclusion of a specific Redemption Event in the audit trail. Generated by Auditor on request.",
      "required": [
        "type",
        "eventId",
        "leafHash",
        "leafIndex",
        "batchIndex",
        "siblings",
        "batchRoot",
        "trailRootId"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "DTEPMerkleProof"
        },
        "eventId": {
          "type": "string",
          "description": "urn:uuid of the event being proven.",
          "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "leafHash": {
          "type": "string",
          "description": "SHA-256 leaf hash of the event. Hex-encoded.",
          "pattern": "^[0-9a-f]{64}$"
        },
        "leafIndex": {
          "type": "integer",
          "description": "Position of this leaf within its batch.",
          "minimum": 0
        },
        "batchIndex": {
          "type": "integer",
          "description": "Index of the batch containing this event.",
          "minimum": 0
        },
        "siblings": {
          "type": "array",
          "description": "Sibling hashes along the path from leaf to batch root. Hex-encoded SHA-256 values.",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "minItems": 1
        },
        "batchRoot": {
          "type": "string",
          "description": "Merkle root recomputed from leafHash and siblings. Must match batchRoot in corresponding trail root.",
          "pattern": "^[0-9a-f]{64}$"
        },
        "trailRootId": {
          "type": "string",
          "description": "urn:uuid of the trail root document this proof corresponds to.",
          "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      },
      "additionalProperties": false
    },
    "auditReport": {
      "type": "object",
      "title": "DTEPAuditReport",
      "description": "Periodic summary of verified delivery evidence. Primary settlement input document. Signed by Auditor.",
      "required": [
        "type",
        "id",
        "auditor",
        "period",
        "summary",
        "trailRootRange",
        "proof"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "DTEPAuditReport"
        },
        "id": {
          "type": "string",
          "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "auditor": {
          "type": "string",
          "pattern": "^did:"
        },
        "period": {
          "type": "object",
          "required": ["from", "until"],
          "properties": {
            "from": {
              "type": "string",
              "format": "date"
            },
            "until": {
              "type": "string",
              "format": "date"
            }
          },
          "additionalProperties": false
        },
        "summary": {
          "type": "object",
          "required": [
            "totalEvents",
            "totalVerifiers",
            "totalCredentials",
            "anomalyFlags",
            "batchesPublished"
          ],
          "properties": {
            "totalEvents": {
              "type": "integer",
              "minimum": 0
            },
            "totalVerifiers": {
              "type": "integer",
              "minimum": 0
            },
            "totalCredentials": {
              "type": "integer",
              "minimum": 0
            },
            "anomalyFlags": {
              "type": "integer",
              "minimum": 0
            },
            "batchesPublished": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "trailRootRange": {
          "type": "object",
          "required": ["first", "last"],
          "properties": {
            "first": {
              "type": "string",
              "description": "urn:uuid of first trail root in period.",
              "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "last": {
              "type": "string",
              "description": "urn:uuid of last trail root in period.",
              "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            }
          },
          "additionalProperties": false
        },
        "anomalies": {
          "type": "array",
          "description": "Anomaly records flagged during the period. See redemption-event.md section 8 for anomaly indicator definitions.",
          "items": {
            "type": "object",
            "required": ["indicator", "eventId", "description"],
            "properties": {
              "indicator": {
                "type": "string",
                "enum": ["A1", "A2", "A3", "A4", "A5", "A6", "A7"],
                "description": "Anomaly indicator code per DTEP-S Redemption Event Specification section 8."
              },
              "eventId": {
                "type": "string",
                "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "proof": {
          "$ref": "#/$defs/auditorProof"
        }
      },
      "additionalProperties": false
    },
    "auditorProof": {
      "type": "object",
      "description": "W3C Data Integrity proof by Auditor key.",
      "required": [
        "type",
        "cryptosuite",
        "created",
        "verificationMethod",
        "proofPurpose",
        "proofValue"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "DataIntegrityProof"
        },
        "cryptosuite": {
          "type": "string",
          "const": "eddsa-rdfc-2022"
        },
        "created": {
          "type": "string",
          "format": "date-time"
        },
        "verificationMethod": {
          "type": "string",
          "pattern": "^did:"
        },
        "proofPurpose": {
          "type": "string",
          "const": "assertionMethod"
        },
        "proofValue": {
          "type": "string",
          "pattern": "^z[1-9A-HJ-NP-Za-km-z]+"
        }
      },
      "additionalProperties": false
    }
  }
}
